"""
Image generation module using mflux (FLUX models on Apple Silicon).

Implements Phase 3 of the research framework: Image Generation Protocol.
"""

import logging
from pathlib import Path
from typing import List, Dict, Any, Optional
from datetime import datetime
import json
from tqdm import tqdm

from mflux.generate import Flux1, Config, ModelConfig


logger = logging.getLogger(__name__)


class ImageGenerator:
    """
    Generate images using mflux FLUX models.

    Implements systematic image generation with version control and metadata tracking
    as specified in the research framework (Phase 3).
    """

    def __init__(self, config: Dict[str, Any]):
        """
        Initialize image generator.

        Args:
            config: Experiment configuration dictionary
        """
        self.config = config
        self.generation_config = config['generation']
        self.output_dir = Path(config.get('output', {}).get('image_dir', 'data/raw/images'))
        self.output_dir.mkdir(parents=True, exist_ok=True)

        # Initialize FLUX model
        self.model_name = self.generation_config.get('model', 'dev')
        logger.info(f"Initializing FLUX.1-{self.model_name} model with mflux...")

        # Map model names to ModelConfig factory functions
        model_map = {
            'dev': ModelConfig.dev,
            'schnell': ModelConfig.schnell,
            'krea_dev': ModelConfig.krea_dev
        }

        # Get the factory function and call it to get the actual ModelConfig instance
        model_factory = model_map.get(self.model_name, ModelConfig.dev)
        try:
            self.model_config = model_factory()
            self.flux = None  # Lazy loading
            logger.info(f"FLUX.1-{self.model_name} model configuration created successfully")
        except Exception as e:
            logger.error(f"Failed to create FLUX.1-{self.model_name} model configuration: {e}")
            self.model_config = None
            self.flux = None  # Lazy loading failed

    def _initialize_model(self):
        """Lazy initialization of FLUX model."""
        if self.flux is None and self.model_config is not None:
            try:
                self.flux = Flux1(model_config=self.model_config)
                logger.info(f"FLUX.1-{self.model_name} model loaded successfully")
            except Exception as e:
                logger.error(f"Failed to initialize FLUX.1-{self.model_name} model: {e}")
                self.flux = None  # Keep as None on failure

    def generate_images_for_prompt(
        self,
        prompt: str,
        prompt_id: str,
        num_images: Optional[int] = None
    ) -> List[Dict[str, Any]]:
        """
        Generate multiple images for a single prompt.

        Args:
            prompt: Text prompt for image generation
            prompt_id: Unique identifier for this prompt
            num_images: Number of images to generate (uses config if None)

        Returns:
            List of dictionaries containing image paths and metadata
        """
        self._initialize_model()

        if num_images is None:
            num_images = self.generation_config['num_images_per_prompt']

        logger.info(f"Generating {num_images} images for prompt: '{prompt}'")

        results = []
        seed_strategy = self.generation_config.get('seed_strategy', 'fixed')
        base_seed = self.generation_config.get('base_seed', 42)
        
        # Check if num_images is valid
        if num_images is None:
            logger.error("num_images_per_prompt not specified in configuration")
            return results
            
        for i in tqdm(range(num_images), desc=f"Generating images for {prompt_id}", leave=False):
            # Determine seed based on strategy
            if seed_strategy == 'fixed':
                seed = base_seed + i
            else:  # random
                import random
                seed = random.randint(0, 2**32 - 1)

            # Generate image
            image_result = self._generate_single_image(prompt, seed)

            # Save image and metadata
            timestamp = datetime.now().isoformat()
            filename = f"{self.model_name}_{prompt_id}_{seed}_{i:04d}.png"
            image_path = self.output_dir / filename

            # Save image
            image_result.image.save(str(image_path))

            # Create metadata
            metadata = {
                'image_path': str(image_path),
                'prompt': prompt,
                'prompt_id': prompt_id,
                'model': f"FLUX.1-{self.model_name}",
                'seed': seed,
                'index': i,
                'timestamp': timestamp,
                'generation_params': {
                    'steps': self.generation_config.get('steps', 4),
                    'guidance_scale': self.generation_config.get('guidance_scale', 3.5),
                    'width': self.generation_config.get('width', 1024),
                    'height': self.generation_config.get('height', 1024),
                }
            }

            # Save metadata alongside image
            metadata_path = image_path.with_suffix('.json')
            with open(metadata_path, 'w') as f:
                json.dump(metadata, f, indent=2)

            results.append(metadata)

        return results

    def _generate_single_image(self, prompt: str, seed: int) -> Any:
        """
        Generate a single image using mflux.

        Args:
            prompt: Text prompt
            seed: Random seed for reproducibility

        Returns:
            Generated image result from mflux
        """
        # Create generation config
        config = Config(
            num_inference_steps=self.generation_config.get('steps', 4),
            height=self.generation_config.get('height', 1024),
            width=self.generation_config.get('width', 1024),
            guidance=self.generation_config.get('guidance_scale', 3.5),
        )

        # Generate image
        if self.flux is None:
            logger.error("FLUX model not initialized - cannot generate image")
            return None
            
        result = self.flux.generate_image(
            seed=seed,
            prompt=prompt,
            config=config
        )

        return result

    def generate_for_all_prompts(self) -> Dict[str, List[Dict[str, Any]]]:
        """
        Generate images for all prompts defined in configuration.

        Returns:
            Dictionary mapping prompt IDs to lists of image metadata
        """
        all_results = {}
        prompts_config = self.config['prompts']

        # Flatten prompts from all categories
        all_prompts = []
        for category, prompts in prompts_config.items():
            for idx, prompt in enumerate(prompts):
                prompt_id = f"{category}_{idx:02d}"
                all_prompts.append((prompt_id, prompt))

        logger.info(f"Generating images for {len(all_prompts)} prompts...")

        for prompt_id, prompt in tqdm(all_prompts, desc="Processing prompts", unit="prompt"):
            results = self.generate_images_for_prompt(prompt, prompt_id)
            all_results[prompt_id] = results

        logger.info(f"\nImage generation complete. Total images: {sum(len(r) for r in all_results.values())}")

        return all_results

    def generate_counterfactual_images(
        self,
        base_prompt: str,
        prompt_id: str,
        demographic_modifiers: Dict[str, List[str]]
    ) -> Dict[str, List[Dict[str, Any]]]:
        """
        Generate counterfactual images with explicit demographic modifiers.

        Implements Phase 6: Counterfactual and Sensitivity Analysis.

        Args:
            base_prompt: Original ambiguous prompt
            prompt_id: Identifier for the base prompt
            demographic_modifiers: Dictionary of demographic categories and their values

        Returns:
            Dictionary mapping modified prompts to image metadata
        """
        logger.info(f"Generating counterfactual images for: '{base_prompt}'")

        results = {}

        for category, values in demographic_modifiers.items():
            for value in values:
                # Create modified prompt
                modified_prompt = f"A {value} {base_prompt.replace('A ', '').replace('An ', '')}"
                modified_id = f"{prompt_id}_cf_{category}_{value}"

                # Generate images
                images = self.generate_images_for_prompt(
                    modified_prompt,
                    modified_id,
                    num_images=self.generation_config['num_images_per_prompt'] // 2  # Fewer for counterfactuals
                )

                results[modified_id] = images

        return results
