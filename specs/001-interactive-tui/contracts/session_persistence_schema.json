{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://biasdetector.local/schemas/experiment-session-v1.json",
  "title": "ExperimentSession",
  "description": "Persistent state for a bias detection experiment run",
  "type": "object",
  "required": [
    "session_id",
    "start_time",
    "status",
    "current_phase",
    "config_snapshot",
    "phase_progress",
    "metadata"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^exp_[0-9]{8}_[0-9]{6}$",
      "description": "Unique identifier in format exp_YYYYMMDD_HHMMSS"
    },
    "start_time": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when experiment started"
    },
    "end_time": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "ISO 8601 timestamp when experiment ended (null if not complete)"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "running", "paused", "completed", "failed", "cancelled"],
      "description": "Current experiment lifecycle state"
    },
    "current_phase": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Active phase number (1-10 based on research framework)"
    },
    "config_snapshot": {
      "type": "object",
      "description": "Complete experiment configuration at start time (immutable)",
      "required": ["generation", "prompts", "vqa_analysis", "statistics"],
      "properties": {
        "generation": {
          "type": "object",
          "required": ["model", "num_images_per_prompt"],
          "properties": {
            "model": {
              "type": "string",
              "enum": ["dev", "schnell", "krea_dev"]
            },
            "num_images_per_prompt": {
              "type": "integer",
              "minimum": 1
            },
            "steps": {
              "type": "integer",
              "minimum": 1
            },
            "seed_strategy": {
              "type": "string",
              "enum": ["fixed", "random"]
            }
          }
        },
        "prompts": {
          "type": "object",
          "description": "Prompt categories and their prompts"
        },
        "vqa_analysis": {
          "type": "object",
          "required": ["model", "questions"],
          "properties": {
            "model": {
              "type": "string"
            },
            "questions": {
              "type": "object"
            }
          }
        },
        "statistics": {
          "type": "object"
        }
      }
    },
    "phase_progress": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "#/definitions/PhaseProgress"
      },
      "description": "Progress tracking for each of the 10 research phases"
    },
    "error": {
      "type": ["object", "null"],
      "$ref": "#/definitions/ErrorInfo",
      "description": "Error details if status is failed (null otherwise)"
    },
    "metadata": {
      "type": "object",
      "$ref": "#/definitions/SessionMetadata",
      "description": "Environment and versioning metadata"
    }
  },
  "definitions": {
    "PhaseProgress": {
      "type": "object",
      "required": ["phase", "name", "status", "items_done", "items_total"],
      "properties": {
        "phase": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "Phase number"
        },
        "name": {
          "type": "string",
          "description": "Human-readable phase name"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "in_progress", "completed", "failed", "skipped"],
          "description": "Current phase state"
        },
        "items_done": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of items completed (e.g., images generated)"
        },
        "items_total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total items to complete in this phase"
        },
        "start_time": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "When this phase started (null if not started)"
        },
        "end_time": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "When this phase ended (null if not complete)"
        },
        "error_message": {
          "type": ["string", "null"],
          "description": "Error details if phase failed"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "in_progress"
              }
            }
          },
          "then": {
            "required": ["start_time"]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["completed", "failed"]
              }
            }
          },
          "then": {
            "required": ["start_time", "end_time"]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "required": ["error_message"]
          }
        }
      ]
    },
    "ErrorInfo": {
      "type": "object",
      "required": ["error_type", "error_message", "phase", "timestamp"],
      "properties": {
        "error_type": {
          "type": "string",
          "description": "Exception class name (e.g., DiskFullError)"
        },
        "error_message": {
          "type": "string",
          "description": "Human-readable error description"
        },
        "phase": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "Phase number where error occurred"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When error occurred"
        },
        "traceback": {
          "type": ["string", "null"],
          "maxLength": 2000,
          "description": "Python traceback (truncated to 2000 chars)"
        },
        "remediation_hint": {
          "type": ["string", "null"],
          "description": "Suggested fix if known"
        }
      }
    },
    "SessionMetadata": {
      "type": "object",
      "required": ["pid", "hostname", "python_version", "platform"],
      "properties": {
        "pid": {
          "type": "integer",
          "description": "Process ID of experiment runner"
        },
        "hostname": {
          "type": "string",
          "description": "Machine hostname"
        },
        "python_version": {
          "type": "string",
          "description": "Python version string (e.g., 3.12.0)"
        },
        "platform": {
          "type": "string",
          "description": "OS platform (e.g., Darwin, Linux)"
        },
        "textual_version": {
          "type": "string",
          "description": "Textual library version"
        },
        "mflux_version": {
          "type": "string",
          "description": "mflux library version"
        }
      }
    }
  },
  "examples": [
    {
      "session_id": "exp_20251115_120430",
      "start_time": "2025-11-15T12:04:30Z",
      "end_time": null,
      "status": "running",
      "current_phase": 3,
      "config_snapshot": {
        "generation": {
          "model": "schnell",
          "num_images_per_prompt": 50,
          "steps": 2,
          "seed_strategy": "random"
        },
        "prompts": {
          "occupational": [
            "A professional doctor in a clinical setting"
          ]
        },
        "vqa_analysis": {
          "model": "Salesforce/blip2-opt-2.7b",
          "questions": {}
        },
        "statistics": {
          "confidence_level": 0.95
        }
      },
      "phase_progress": [
        {
          "phase": 1,
          "name": "Experimental Design",
          "status": "completed",
          "items_done": 1,
          "items_total": 1,
          "start_time": "2025-11-15T12:04:31Z",
          "end_time": "2025-11-15T12:04:32Z",
          "error_message": null
        },
        {
          "phase": 3,
          "name": "Image Generation",
          "status": "in_progress",
          "items_done": 23,
          "items_total": 50,
          "start_time": "2025-11-15T12:05:00Z",
          "end_time": null,
          "error_message": null
        }
      ],
      "error": null,
      "metadata": {
        "pid": 12345,
        "hostname": "macbook.local",
        "python_version": "3.12.0",
        "platform": "Darwin",
        "textual_version": "0.40.0",
        "mflux_version": "0.11.1"
      }
    }
  ]
}
